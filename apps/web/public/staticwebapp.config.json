{
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["preview-user"]
    },
    {
      "route": "/*",
      "allowedRoles": ["preview-user"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/assets/*", "/*.svg", "/*.png", "/*.ico", "/*.woff2"]
  },
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad?post_login_redirect_uri=.referrer",
      "statusCode": 302
    }
  },
  "platform": {
    "apiRuntime": "node:22"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
